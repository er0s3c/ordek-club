# ─────────────────────────────────────────────────────────────────────────────
#  Ördek Club — ortam değişkenleri
#  Üretimde bu dosyayı elle kopyalamayın: ./install.sh güçlü rastgele değerlerle
#  .env üretir. Aşağıdaki değerler yalnızca YEREL GELİŞTİRME içindir.
# ─────────────────────────────────────────────────────────────────────────────

# Uygulamanın dışarıdan görünen adresi (çerezlerin Secure bayrağı buna göre ayarlanır).
APP_URL=http://localhost:3100
PORT=3100

# PostgreSQL. Docker Compose bu değerlerden DATABASE_URL üretir.
POSTGRES_USER=club
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=ordek_club
DATABASE_URL=postgresql://club:change-me-local-dev-only@localhost:5433/ordek_club?schema=public

# Uygulama sırrı (ileride WebSocket bilet imzası vb. için). install.sh 48 baytlık rastgele değer yazar.
APP_SECRET=dev-only-insecure-secret-change-me-0123456789abcdef

# Kalıcı dosya deposu (logo, yüklemeler). Docker'da volume'a bağlanır.
STORAGE_DIR=./storage

# Akademi içeriği (Markdown). Docker imajında /app/content/academy; konteyner her başladığında
# içerik veritabanına aktarılır (kapatmak için ACADEMY_AUTO_IMPORT=0).
ACADEMY_DIR=./content/academy

# Ters vekil (Caddy) arkasındaysa 1: istemci IP'si X-Forwarded-For'dan okunur.
# Doğrudan internete açık kurulumda 0 bırakın (aksi halde IP sahtelenebilir).
TRUST_PROXY=0

# HTTPS (opsiyonel Caddy profili). Alan adı DNS'te bu sunucuya işaret etmeli.
DOMAIN=
# Uygulama portunun bağlanacağı adres. Caddy kullanılıyorsa 127.0.0.1 yapın.
APP_BIND=0.0.0.0

# ── E-posta (isteğe bağlı) ──────────────────────────────────────────────────
# SMTP_HOST boşsa: üretimde e-posta kapalıdır; geliştirmede e-postalar storage/mail/ altına yazılır.
# SMTP_SECURE=1 → doğrudan TLS (genelde 465); 0 → STARTTLS zorunlu (genelde 587). Düz metin SMTP kullanılmaz.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Virüs taraması (isteğe bağlı) ───────────────────────────────────────────
# docker compose --profile clamav up -d  ile clamd başlatılır; CLAMAV_HOST=clamav yapın.
# Tanımlıysa her yükleme taranır; tarayıcıya ulaşılamazsa yükleme reddedilir.
CLAMAV_HOST=
CLAMAV_PORT=3310
