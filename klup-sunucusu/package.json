{
  "name": "ordek-club",
  "version": "0.1.0",
  "private": true,
  "description": "Ördek Club — üniversite siber güvenlik kulüpleri için bağımsız eğitim platformu",
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "predev": "npm run motion:assets && npm run vendor:assets && npm run db:generate && npm run db:migrate",
    "dev": "tsx server.ts",
    "build": "npm run motion:assets && npm run vendor:assets && prisma generate && next build && npm run build:server",
    "build:server": "esbuild server.ts cli.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --outdir=dist --tsconfig=tsconfig.json",
    "prestart": "npm run db:migrate",
    "start": "node dist/server.js",
    "cli": "tsx cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "smoke": "node scripts/smoke.mjs",
    "academy:check": "node scripts/academy.mjs check",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:coverage": "node scripts/i18n-coverage.mjs",
    "academy:gorseller": "node scripts/academy.mjs gorseller",
    "academy:gemini": "node scripts/gemini-images.mjs",
    "test:e2e": "npm run build && node e2e/prepare.mjs && playwright test",
    "test:e2e:run": "node e2e/prepare.mjs && playwright test",
    "test:pure": "vitest run --config vitest.pure.config.ts",
    "test:lab-policy": "node --test lab-runner/policy.test.mjs",
    "lab:check": "tsx scripts/check-lab.ts",
    "lab:pilot-test": "tsx scripts/test-lab.ts",
    "test:slide-converter": "node --test slide-converter/policy.test.mjs",
    "preview:learning": "node scripts/preview-learning.mjs --serve",
    "academy:pilot-check": "tsx scripts/check-pilot-drafts.ts",
    "motion:assets": "node scripts/sync-motion-assets.mjs",
    "motion:duck": "node scripts/build-duck-rive.mjs",
    "test:motion": "playwright test --config playwright.motion.config.ts",
    "test:content": "playwright test --config playwright.content.config.ts",
    "vendor:assets": "node scripts/sync-vendor-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/lexend-tera": "5.3.0",
    "@fontsource/readex-pro": "5.3.0",
    "@formkit/auto-animate": "0.10.0",
    "@lottiefiles/dotlottie-web": "0.81.0",
    "@motion-canvas/2d": "3.17.2",
    "@motion-canvas/core": "3.17.2",
    "@next/env": "^15.5.28",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.3.1",
    "@rive-app/canvas": "2.45.1",
    "@rive-app/react-canvas": "4.37.1",
    "@theatre/core": "0.7.2",
    "@theatre/studio": "0.7.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "12.12.0",
    "animejs": "4.5.0",
    "asciinema-player": "3.17.0",
    "codehike": "1.1.0",
    "cytoscape": "3.34.4",
    "elkjs": "0.12.0",
    "gsap": "3.15.0",
    "jszip": "3.10.2",
    "lib0": "0.2.119",
    "lottie-web": "5.13.0",
    "lucide-react": "^1.61.0",
    "marked": "^15.0.12",
    "mermaid": "12.2.0",
    "monaco-editor": "0.57.0",
    "motion": "14.6.0",
    "next": "15.5.28",
    "nodemailer": "10.0.10",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "prisma": "6.19.3",
    "pyodide": "314.0.7",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "roughjs": "4.6.6",
    "shiki": "4.5.0",
    "shiki-magic-move": "1.3.2",
    "v86": "0.5.472",
    "ws": "^8.22.0",
    "y-protocols": "1.0.7",
    "yaml": "^2.9.1",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "postcss": "^8.5.31",
    "deepmerge-ts": "^8.0.2",
    "dompurify": "3.4.17",
    "lodash-es": "4.18.1",
    "@excalidraw/excalidraw": {
      "nanoid": "3.3.20"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "5.1.16"
    }
  }
}
