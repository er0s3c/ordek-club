{
  "name": "ordek-club",
  "version": "0.1.0",
  "private": true,
  "description": "Ördek Club — üniversite siber güvenlik kulüpleri için bağımsız eğitim platformu",
  "license": "MIT",
  "engines": {
    "node": ">=20.18"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build && npm run build:server",
    "build:server": "esbuild server.ts cli.ts --bundle --platform=node --target=node20 --format=cjs --packages=external --outdir=dist --tsconfig=tsconfig.json",
    "start": "node dist/server.js",
    "cli": "tsx cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "smoke": "node scripts/smoke.mjs",
    "academy:check": "node scripts/academy.mjs check",
    "academy:gorseller": "node scripts/academy.mjs gorseller",
    "test:e2e": "npm run build && node e2e/prepare.mjs && playwright test",
    "test:e2e:run": "node e2e/prepare.mjs && playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@next/env": "^15.5.28",
    "@prisma/client": "6.19.3",
    "lucide-react": "^1.61.0",
    "marked": "^15.0.12",
    "next": "15.5.28",
    "nodemailer": "10.0.10",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "overrides": {
    "postcss": "^8.5.31",
    "deepmerge-ts": "^8.0.2"
  }
}
