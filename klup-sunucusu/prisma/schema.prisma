// ============================================================================
//  Ördek Club — veritabanı şeması
//  Faz 1: kimlik, üyelik, davet, kulüp ayarları, audit log.
//  Sonraki fazların modelleri (Presentation, LiveSession, Lesson, XPTransaction…)
//  kendi migration'larıyla eklenecek; uygulanmış migration'lar düzenlenmez.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  INSTRUCTOR
  STUDENT
}

// Üyelik durumu. PENDING: başvuru onay bekliyor. REJECTED: başvuru reddedildi.
// DISABLED: admin tarafından devre dışı bırakılmış aktif hesap.
enum MemberStatus {
  PENDING
  ACTIVE
  REJECTED
  DISABLED
}

enum RegistrationPolicy {
  OPEN // herkes kayıt olur, otomatik aktif
  APPROVAL // herkes başvurur, admin onaylar (davet kodu autoApprove ise atlanır)
  INVITE_ONLY // yalnızca geçerli davet koduyla
  CLOSED // yeni kayıt yok
}

model User {
  id                 String       @id @default(cuid())
  username           String       @unique // küçük harf, normalize edilmiş
  email              String       @unique // küçük harf, normalize edilmiş
  displayName        String
  passwordHash       String
  role               Role         @default(STUDENT)
  status             MemberStatus @default(PENDING)
  // Başvuru bilgileri (veri minimizasyonu: yalnızca kulübün ihtiyaç duyduğu alanlar)
  studentNumber      String?
  department         String?
  applicationNote    String?
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?        @relation("UserReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewed           User[]       @relation("UserReviews")
  invitationId       String?
  invitation         Invitation?  @relation("InvitationUses", fields: [invitationId], references: [id], onDelete: SetNull)
  // Kulübe katılım (onay) zamanı — genel liderlik tablosu bu tarihten sayar.
  joinedAt           DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime     @default(now())
  // E-posta bildirimleri (SMTP yapılandırılmışsa gönderilir); kişi profilinden kapatabilir.
  emailNotifications Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions            Session[]
  invitationsCreated  Invitation[]           @relation("InvitationCreator")
  auditLogs           AuditLog[]
  presentations       Presentation[]         @relation("PresentationOwner")
  versionsAuthored    PresentationVersion[]  @relation("VersionAuthor")
  hostedSessions      LiveSession[]          @relation("LiveHost")
  participations      SessionParticipant[]
  liveEvents          LiveSessionEvent[]     @relation("LiveEventAuthor")
  lessonProgress      LessonProgress[]
  quizAttempts        QuizAttempt[]
  missionAttempts     MissionAttempt[]
  xpTransactions      XpTransaction[]        @relation("XpOwner")
  xpAuthored          XpTransaction[]        @relation("XpAuthor")
  badges              UserBadge[]            @relation("BadgeOwner")
  activityDays        ActivityDay[]          @relation("ActivityOwner")
  leaderboardEntries  LeaderboardEntry[]     @relation("LeaderboardUser")
  filesOwned          FileAsset[]            @relation("FileOwner")
  fileGrants          FileGrant[]            @relation("FileGrantUser")
  assignmentsAuthored Assignment[]           @relation("AssignmentAuthor")
  assignmentTargets   AssignmentTarget[]     @relation("AssignmentTargetUser")
  submissions         Submission[]           @relation("SubmissionAuthor")
  reviews             Submission[]           @relation("SubmissionReviewer")
  announcements       Announcement[]         @relation("AnnouncementAuthor")
  notifications       Notification[]         @relation("NotificationOwner")
  pollAnswers         LivePollAnswer[]       @relation("PollAnswerUser")
  groupsAuthored      ClassGroup[]           @relation("GroupAuthor")
  groupMemberships    ClassGroupMember[]     @relation("GroupMember")
  teamMemberships     AssignmentTeamMember[] @relation("TeamMember")
  passwordResets      PasswordResetToken[]

  @@index([status, role])
  @@index([createdAt])
}

// Opak oturum token'ı: çerezde ham değer, burada yalnızca SHA-256 hash'i.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id          String    @id @default(cuid())
  label       String
  // Kod yalnızca oluşturulurken bir kez gösterilir; burada SHA-256 hash'i ve tanıma öneki tutulur.
  codeHash    String    @unique
  codePrefix  String
  role        Role      @default(STUDENT)
  autoApprove Boolean   @default(false)
  maxUses     Int?
  useCount    Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  users       User[]    @relation("InvitationUses")

  @@index([createdAt])
}

// Tekil satır (id = 1). Kurulum tamamlanana kadar setupCompletedAt null'dır.
model ClubSettings {
  id                 Int                @id @default(1)
  clubName           String             @default("Ördek Club")
  description        String             @default("")
  universityName     String             @default("")
  appUrl             String             @default("")
  logoFile           String? // storage/branding altındaki dosya adı
  logoMime           String?
  logoUpdatedAt      DateTime?
  theme              String             @default("dark")
  locale             String             @default("tr")
  timezone           String             @default("Europe/Istanbul")
  registrationPolicy RegistrationPolicy @default(APPROVAL)
  maxUploadMb        Int                @default(25)
  storageQuotaMb     Int                @default(5120) // tüm kulüp dosyaları
  userQuotaMb        Int                @default(200) // öğrenci başına teslim dosyaları
  sessionMaxAgeDays  Int                @default(14)
  sessionIdleHours   Int                @default(72)
  // Güvenli bootstrap: tek seferlik kurulum anahtarının hash'i (kurulumdan sonra silinir).
  setupTokenHash     String?
  setupTokenExpires  DateTime?
  setupCompletedAt   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // ör. "member.approve", "settings.update", "auth.login.failed"
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

// ============================================================================
//  Faz 2 — Sunumlar ve canlı sınıf
// ============================================================================

enum PresentationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Presentation {
  id               String                @id @default(cuid())
  title            String
  description      String                @default("")
  status           PresentationStatus    @default(DRAFT)
  ownerId          String?
  owner            User?                 @relation("PresentationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // En güncel sürüm (canlı oturumlar başlatıldıkları sürüme bağlı kalır).
  currentVersionId String?               @unique
  currentVersion   PresentationVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  templateKey      String? // hazır şablondan oluşturulduysa
  // Club Studio otomatik kaydı: yayınlanmamış çalışma kopyası (sürüm oluşturmaz)
  draft            Json?
  draftUpdatedAt   DateTime?
  // Eğitmenlerin "şablon olarak kaydet" ile paylaştığı sunumlar
  isTemplate       Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  versions         PresentationVersion[] @relation("PresentationVersions")
  liveSessions     LiveSession[]

  @@index([status, updatedAt])
  @@index([ownerId])
}

// Değişmez anlık görüntü: içerik değişince yeni sürüm oluşur.
model PresentationVersion {
  id             String        @id @default(cuid())
  presentationId String
  presentation   Presentation  @relation("PresentationVersions", fields: [presentationId], references: [id], onDelete: Cascade)
  number         Int
  // Deste düzeyi alanlar (tema, şema sürümü). Slaytlar Slide satırlarındadır.
  meta           Json
  createdById    String?
  createdBy      User?         @relation("VersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  slides         Slide[]
  currentOf      Presentation? @relation("CurrentVersion")
  liveSessions   LiveSession[]

  @@unique([presentationId, number])
}

model Slide {
  id        String              @id @default(cuid())
  versionId String
  version   PresentationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  // Blok listesi (src/lib/deck-schema.ts ile doğrulanır)
  blocks    Json
  // Eğitmen notları: öğrencilere ASLA gönderilmez
  notes     String              @default("")
  steps     Int                 @default(1)

  @@unique([versionId, position])
}

enum LiveSessionStatus {
  ACTIVE
  ENDED
}

model LiveSession {
  id             String               @id @default(cuid())
  code           String               @unique
  title          String
  presentationId String?
  presentation   Presentation?        @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  versionId      String
  version        PresentationVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  hostId         String?
  host           User?                @relation("LiveHost", fields: [hostId], references: [id], onDelete: SetNull)
  status         LiveSessionStatus    @default(ACTIVE)
  // Sunucuda tutulan senkron durum + sürüm numarası (her değişiklikte +1)
  state          Json
  stateVersion   Int                  @default(0)
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  participants   SessionParticipant[]
  events         LiveSessionEvent[]
  polls          LivePoll[]
  assignments    Assignment[]

  @@index([status, startedAt])
}

model SessionParticipant {
  id           String      @id @default(cuid())
  sessionId    String
  session      LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstJoinAt  DateTime    @default(now())
  lastSeenAt   DateTime    @default(now())
  connectedMs  Int         @default(0)
  connectCount Int         @default(0)
  handRaisedAt DateTime?

  @@unique([sessionId, userId])
}

enum LiveEventType {
  QUESTION
  ANNOUNCEMENT
  HAND
}

model LiveSessionEvent {
  id         String        @id @default(cuid())
  sessionId  String
  session    LiveSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?         @relation("LiveEventAuthor", fields: [userId], references: [id], onDelete: SetNull)
  type       LiveEventType
  text       String        @default("")
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([sessionId, type, createdAt])
}

// ============================================================================
//  Faz 3 — Club Academy
//  İçeriğin kaynağı content/academy/ (Markdown). İçe aktarıcı bu tabloları doldurur;
//  ilerleme ve quiz denemeleri öğrenciye aittir ve içerik yeniden aktarılınca korunur.
// ============================================================================

enum TrackKind {
  PROGRAM // akademi hakkında
  CORE // Kısım I — temel modüller (Sezon 1)
  SPECIALIZATION // Kısım II — uzmanlık yolları (Sezon 2)
}

enum LessonKind {
  INFO
  LESSON
  PRACTICE
  QUIZ
}

model Track {
  id         String    @id @default(cuid())
  key        String    @unique // akademi.yaml → anahtar (ör. "m01", "yol-a")
  code       String // görünen kısa kod (ör. "M01", "Yol A")
  kind       TrackKind
  title      String
  summary    String    @default("")
  position   Int
  // Kötü adam ve bölüm bilgisi (karakterler.yaml'dan): { id, ad, unvan, tehdit, ozet, bolum, giris }
  villain    Json?
  archivedAt DateTime? // içerikten kaldırılan yol (ilerleme korunur)
  updatedAt  DateTime  @updatedAt
  lessons    Lesson[]

  @@index([kind, position])
}

model Lesson {
  id              String           @id @default(cuid())
  slug            String           @unique // sayfa kimliği (ör. "m01-04") — içerik boyunca sabit
  trackId         String
  track           Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position        Int
  kind            LessonKind
  title           String
  minutes         Int              @default(5)
  goals           String[]
  // Markdown gövdesi: iç bağlantılar /academy/..., görseller /api/academy/images/... olarak yeniden yazılmış hâli
  body            String
  // Quiz soruları DOĞRU CEVAPLARLA birlikte burada durur; istemciye asla olduğu gibi gönderilmez.
  quiz            Json?
  // Mini görevler (front-matter `gorevler:`) DOĞRU CEVAP ve geri bildirimleriyle; istemciye publicMissions ile süzülerek gider.
  missions        Json?
  passPercent     Int?
  sourcePath      String // content/academy içindeki göreli yol
  contentHash     String
  archivedAt      DateTime?
  updatedAt       DateTime         @updatedAt
  progress        LessonProgress[]
  attempts        QuizAttempt[]
  missionAttempts MissionAttempt[]

  @@index([trackId, position])
  @@index([trackId, archivedAt])
}

enum ProgressStatus {
  STARTED
  COMPLETED
}

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(STARTED)
  startedAt   DateTime       @default(now())
  lastViewAt  DateTime       @default(now())
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([lessonId, status])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers   Json // öğrencinin seçimleri (soru sırasıyla)
  correct   Int
  total     Int
  score     Int // yüzde
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, lessonId, createdAt])
}

// Mini görev denemeleri: ilerlemenin tek kaynağı. step dolu = adım kontrolü, step boş = görevin tamamlanması.
// firstTry ayrı alan değil; görevdeki ilk yanlış satırdan türetilir. hintsUsed yalnızca öğrenme gözlemi içindir (XP'yi etkilemez).
model MissionAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  missionId String
  step      Int?
  choice    Json
  correct   Boolean
  hintsUsed Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, lessonId, missionId])
}

// ============================================================================
//  Faz 4 — XP, seviyeler, rozetler, liderlik tabloları
//  XP yalnızca sunucuda, kayıt defteri (ledger) olarak tutulur: her kazanım/geri alma ayrı satırdır,
//  toplam her zaman SUM(amount)'tır. idempotencyKey aynı ödülün iki kez verilmesini veritabanı düzeyinde engeller.
//  Kulüp XP'si Ördek Lab XP sisteminden tamamen ayrıdır.
// ============================================================================

enum XpSource {
  LESSON
  QUIZ
  TRACK
  LIVE
  TASK
  MANUAL
  REVERSAL
}

// Ödül kuralları (miktarlar yönetim panelinden değiştirilebilir).
model XpRewardRule {
  key         String   @id // ör. "lesson.complete", "quiz.pass", "track.complete"
  label       String
  amount      Int
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model XpTransaction {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation("XpOwner", fields: [userId], references: [id], onDelete: Cascade)
  amount         Int // geri alma ve düzeltmelerde negatif olabilir
  source         XpSource
  ruleKey        String?
  // Aynı ödül ikinci kez yazılamaz (ör. "quiz.pass:<kullanıcı>:<ders>")
  idempotencyKey String         @unique
  reason         String         @default("")
  refType        String?
  refId          String?
  createdById    String?
  createdBy      User?          @relation("XpAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  // Geri alınan işlem; bir işlem en fazla bir kez geri alınabilir
  reversalOfId   String?        @unique
  reversalOf     XpTransaction? @relation("XpReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy     XpTransaction? @relation("XpReversal")
  createdAt      DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Level {
  number Int    @id
  minXp  Int    @unique
  title  String
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String      @default("")
  icon        String      @default("award") // izinli simge listesinden
  // Otomatik kazanım kuralı: { type: "lessons"|"quizzes"|"streak"|"track"|"track_kind"|"xp"|"monthly_rank"|"overall_rank"|"manual", ... }
  rule        Json
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  awards      UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("BadgeOwner", fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  reason      String   @default("")
  awardedById String?
  awardedAt   DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([badgeId])
}

// Öğrenme serileri için: kulübün saat dilimine göre öğrenme yapılan günler.
model ActivityDay {
  userId String
  user   User   @relation("ActivityOwner", fields: [userId], references: [id], onDelete: Cascade)
  day    String // YYYY-MM-DD (kulüp saat dilimi)

  @@id([userId, day])
}

// Ay kapanınca sıralama arşivlenir; geçmiş aylar buradan okunur.
model LeaderboardPeriod {
  period     String             @id // YYYY-MM
  timezone   String
  archivedAt DateTime           @default(now())
  entries    LeaderboardEntry[]
}

model LeaderboardEntry {
  id     String            @id @default(cuid())
  period String
  board  LeaderboardPeriod @relation(fields: [period], references: [period], onDelete: Cascade)
  userId String
  user   User              @relation("LeaderboardUser", fields: [userId], references: [id], onDelete: Cascade)
  rank   Int
  xp     Int

  @@unique([period, userId])
  @@index([period, rank])
}

// ============================================================================
//  Faz 5 — Sınıf yönetimi: dosyalar, görevler, duyurular, bildirimler, canlı quiz/anket
// ============================================================================

// Dosyalar hiçbir zaman statik dizinden sunulmaz: STORAGE_DIR/files altında rastgele adla durur,
// yetki her indirmede sunucuda kontrol edilir.
enum FileScope {
  CLUB // tüm aktif üyeler
  USERS // yalnız izin verilen üyeler (FileGrant)
  ASSIGNMENT // görevin hedefindeki öğrenciler + personel
  SUBMISSION // teslim eden öğrenci + personel
  GROUP // sınıf/etkinlik üyeleri + personel
  MEDIA // sunum görselleri: tüm aktif üyeler (kütüphanede listelenmez)
}

model FileAsset {
  id           String      @id @default(cuid())
  name         String // temizlenmiş görünen ad (yalnızca indirme başlığında kullanılır)
  storageKey   String      @unique // sunucunun ürettiği rastgele dosya adı
  mime         String
  kind         String // pdf | text | image | pcap | zip
  size         Int
  sha256       String
  description  String      @default("")
  scope        FileScope
  ownerId      String?
  owner        User?       @relation("FileOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  groupId      String?
  group        ClassGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Tarama özeti (ör. "zip:12 öğe", "clamav:temiz")
  scanNote     String      @default("")
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?
  grants       FileGrant[]

  @@index([scope, deletedAt, createdAt])
  @@index([ownerId])
  @@index([assignmentId])
  @@index([submissionId])
  @@index([groupId])
}

model FileGrant {
  fileId String
  file   FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("FileGrantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([fileId, userId])
  @@index([userId])
}

enum AssignmentKind {
  TEXT
  SHORT_ANSWER
  FILE
  PCAP
  LOG
  OSINT
  CODE_REVIEW
  VMWARE
  QUIZ // otomatik puanlanan (çoktan seçmeli, çoklu seçim, D/Y, kısa cevap, eşleştirme)
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AssignmentAudience {
  ALL // tüm aktif öğrenciler
  SELECTED // yalnız AssignmentTarget'taki öğrenciler
  GROUP // bir sınıfın/etkinliğin üyeleri
}

model Assignment {
  id            String             @id @default(cuid())
  title         String
  description   String             @default("") // Markdown
  kind          AssignmentKind     @default(TEXT)
  difficulty    Difficulty         @default(MEDIUM)
  status        AssignmentStatus   @default(DRAFT)
  audience      AssignmentAudience @default(ALL)
  startsAt      DateTime           @default(now())
  dueAt         DateTime?
  allowLate     Boolean            @default(false)
  allowResubmit Boolean            @default(true)
  requireText   Boolean            @default(true)
  requireFile   Boolean            @default(false)
  maxScore      Int                @default(100)
  // Değerlendirme ölçütleri: [{ criterion, points }]
  rubric        Json?
  // XP miktarı sunucudaki kuraldan gelir; xpAmount yalnız personelin sınırlı aralıkta verdiği özel değerdir.
  xpRuleKey     String             @default("task.approved")
  xpAmount      Int?
  createdById   String?
  createdBy     User?              @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  // VMware uygulama molası: canlı oturumdaki slayta bağlı görev
  liveSessionId String?
  liveSession   LiveSession?       @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  slideId       String?
  groupId       String?
  group         ClassGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Grup görevi: takım başına tek teslim; onayda XP takımdaki herkese
  teamMode      Boolean            @default(false)
  // Otomatik puanlanan görev: sorular (cevap anahtarı yalnız sunucuda), geçme yüzdesi, deneme sınırı
  quiz          Json?
  passPercent   Int                @default(60)
  maxAttempts   Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  teams         AssignmentTeam[]
  targets       AssignmentTarget[]
  submissions   Submission[]
  files         FileAsset[]

  @@unique([liveSessionId, slideId])
  @@index([status, startsAt])
  @@index([createdById])
}

model AssignmentTarget {
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("AssignmentTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
  @@index([userId])
}

enum SubmissionStatus {
  SUBMITTED // değerlendirme bekliyor
  RETURNED // düzeltme istendi (yeniden teslim edilebilir)
  APPROVED // onaylandı (XP verildi; kesindir)
  REJECTED // reddedildi
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("SubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  text         String           @default("")
  status       SubmissionStatus @default(SUBMITTED)
  attempts     Int              @default(1)
  late         Boolean          @default(false)
  submittedAt  DateTime         @default(now())
  score        Int?
  rubricScores Json?
  feedback     String           @default("")
  reviewedById String?
  reviewedBy   User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  teamId       String?          @unique
  team         AssignmentTeam?  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  answers      Json?
  files        FileAsset[]

  @@unique([assignmentId, userId])
  @@index([assignmentId, status])
}

enum AnnouncementAudience {
  ALL
  STAFF
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String               @default("") // Markdown
  audience    AnnouncementAudience @default(ALL)
  pinned      Boolean              @default(false)
  createdById String?
  createdBy   User?                @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  expiresAt   DateTime?

  @@index([createdAt])
}

enum NotificationType {
  ANNOUNCEMENT
  ASSIGNMENT
  REVIEW
  SUBMISSION
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String           @default("")
  link      String? // yalnız uygulama içi yol (/ ile başlar)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

enum PollKind {
  QUIZ // doğru cevabı olan, isimli
  POLL // anket (isteğe bağlı anonim)
}

enum PollStatus {
  OPEN
  CLOSED
  REVEALED
}

model LivePoll {
  id           String           @id @default(cuid())
  sessionId    String
  session      LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind         PollKind
  question     String
  options      Json // string[]
  correctIndex Int? // yalnız QUIZ; sonuç açıklanana kadar öğrenciye gönderilmez
  anonymous    Boolean          @default(false)
  timeLimitSec Int
  status       PollStatus       @default(OPEN)
  openedAt     DateTime         @default(now())
  closesAt     DateTime
  answers      LivePollAnswer[]

  @@index([sessionId, openedAt])
}

model LivePollAnswer {
  pollId    String
  poll      LivePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PollAnswerUser", fields: [userId], references: [id], onDelete: Cascade)
  choice    Int
  createdAt DateTime @default(now())

  @@id([pollId, userId])
}

// ───────────────────────────── Faz 6 ─────────────────────────────

enum GroupKind {
  CLASS // sınıf/şube: üyeleri personel belirler
  EVENT // etkinlik: tarih/yer; isteğe bağlı öğrenci kaydı
}

model ClassGroup {
  id          String             @id @default(cuid())
  kind        GroupKind          @default(CLASS)
  name        String
  description String             @default("")
  startsAt    DateTime?
  endsAt      DateTime?
  location    String             @default("")
  selfJoin    Boolean            @default(false) // öğrenci kendisi kaydolabilir (etkinlik)
  capacity    Int?
  archivedAt  DateTime?
  createdById String?
  createdBy   User?              @relation("GroupAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     ClassGroupMember[]
  assignments Assignment[]
  files       FileAsset[]

  @@index([kind, archivedAt])
}

model ClassGroupMember {
  groupId  String
  group    ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation("GroupMember", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model AssignmentTeam {
  id           String                 @id @default(cuid())
  assignmentId String
  assignment   Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name         String
  members      AssignmentTeamMember[]
  submission   Submission?

  @@unique([assignmentId, name])
}

model AssignmentTeamMember {
  teamId       String
  team         AssignmentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation("TeamMember", fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String // bir öğrenci bir görevde tek takımda olabilir

  @@id([teamId, userId])
  @@unique([assignmentId, userId])
}

// Parola sıfırlama: e-postadaki token'ın yalnız SHA-256 hash'i; tek kullanımlık, kısa ömürlü.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String    @default("")
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// Giden e-posta kuyruğu: istek yolunu SMTP'ye bağlamaz; arka plan işçisi gönderir ve yeniden dener.
model EmailOutbox {
  id            String      @id @default(cuid())
  to            String
  subject       String
  text          String
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  lastError     String      @default("")
  nextAttemptAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}
