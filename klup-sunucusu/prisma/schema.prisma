// ============================================================================
//  Ördek Club — veritabanı şeması
//  Faz 1: kimlik, üyelik, davet, kulüp ayarları, audit log.
//  Sonraki fazların modelleri (Presentation, LiveSession, Lesson, XPTransaction…)
//  kendi migration'larıyla eklenecek; uygulanmış migration'lar düzenlenmez.
// ============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  INSTRUCTOR
  STUDENT
}

// Üyelik durumu. PENDING: başvuru onay bekliyor. REJECTED: başvuru reddedildi.
// DISABLED: admin tarafından devre dışı bırakılmış aktif hesap.
enum MemberStatus {
  PENDING
  ACTIVE
  REJECTED
  DISABLED
}

enum RegistrationPolicy {
  OPEN // herkes kayıt olur, otomatik aktif
  APPROVAL // herkes başvurur, admin onaylar (davet kodu autoApprove ise atlanır)
  INVITE_ONLY // yalnızca geçerli davet koduyla
  CLOSED // yeni kayıt yok
}

model User {
  id                 String       @id @default(cuid())
  username           String       @unique // küçük harf, normalize edilmiş
  email              String       @unique // küçük harf, normalize edilmiş
  displayName        String
  passwordHash       String
  role               Role         @default(STUDENT)
  status             MemberStatus @default(PENDING)
  // Başvuru bilgileri (veri minimizasyonu: yalnızca kulübün ihtiyaç duyduğu alanlar)
  studentNumber      String?
  department         String?
  applicationNote    String?
  reviewNote         String?
  reviewedAt         DateTime?
  reviewedById       String?
  reviewedBy         User?        @relation("UserReviews", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewed           User[]       @relation("UserReviews")
  invitationId       String?
  invitation         Invitation?  @relation("InvitationUses", fields: [invitationId], references: [id], onDelete: SetNull)
  // Kulübe katılım (onay) zamanı — genel liderlik tablosu bu tarihten sayar.
  joinedAt           DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime     @default(now())
  // E-posta bildirimleri (SMTP yapılandırılmışsa gönderilir); kişi profilinden kapatabilir.
  emailNotifications Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  sessions            Session[]
  invitationsCreated  Invitation[]           @relation("InvitationCreator")
  auditLogs           AuditLog[]
  presentations       Presentation[]         @relation("PresentationOwner")
  versionsAuthored    PresentationVersion[]  @relation("VersionAuthor")
  hostedSessions      LiveSession[]          @relation("LiveHost")
  participations      SessionParticipant[]
  liveEvents          LiveSessionEvent[]     @relation("LiveEventAuthor")
  lessonProgress      LessonProgress[]
  quizAttempts        QuizAttempt[]
  missionAttempts     MissionAttempt[]
  xpTransactions      XpTransaction[]        @relation("XpOwner")
  xpAuthored          XpTransaction[]        @relation("XpAuthor")
  badges              UserBadge[]            @relation("BadgeOwner")
  activityDays        ActivityDay[]          @relation("ActivityOwner")
  leaderboardEntries  LeaderboardEntry[]     @relation("LeaderboardUser")
  filesOwned          FileAsset[]            @relation("FileOwner")
  fileGrants          FileGrant[]            @relation("FileGrantUser")
  assignmentsAuthored Assignment[]           @relation("AssignmentAuthor")
  assignmentTargets   AssignmentTarget[]     @relation("AssignmentTargetUser")
  submissions         Submission[]           @relation("SubmissionAuthor")
  reviews             Submission[]           @relation("SubmissionReviewer")
  announcements       Announcement[]         @relation("AnnouncementAuthor")
  notifications       Notification[]         @relation("NotificationOwner")
  pollAnswers         LivePollAnswer[]       @relation("PollAnswerUser")
  groupsAuthored      ClassGroup[]           @relation("GroupAuthor")
  groupMemberships    ClassGroupMember[]     @relation("GroupMember")
  teamMemberships     AssignmentTeamMember[] @relation("TeamMember")
  passwordResets      PasswordResetToken[]
  activitySolutions   ActivitySolution[]
  placementAttempts   PlacementAttempt[]
  portfolioWorks      PortfolioWork[]
  bankQuestions       BankQuestion[]
  ctfMembership       CtfTeamMember?
  captainOfTeams      CtfTeam[]
  examAttempts        TrackExamAttempt[]
  certificates        LearningCertificate[]
  operationMemberships OperationParticipant[]
  operationVotes OperationVote[]
  reportDrafts ReportDraft[]
  socAttempts SocAttempt[]
  learningPreference  LearningPreference?
  learningEvents      LearningEvent[]
  learningPlans       LearningPlan[]
  lessonPersonal      LessonPersonal[]
  reviewCards         ReviewCard[]
  reminderReceipts    LearningReminder[]
  studySessions       StudySession[]
  studyGoal           StudyGoal?
  buddyPosts          BuddyPost[]
  buddyReplies        BuddyReply[]
  circlesOwned        StudyCircle[]
  circleMemberships   StudyCircleMember[]
  thanksGiven         Thanks[]               @relation("ThanksFrom")
  thanksReceived      Thanks[]               @relation("ThanksTo")
  lessonQuestions     LessonQuestion[]
  lessonAnswers       LessonAnswer[]
  lessonFeedback      LessonFeedback[]
  issueReports        IssueReport[]          @relation("IssueReporter")
  helpRequests        HelpRequest[]
  peerReviews         PeerReview[]
  extensionRequests   ExtensionRequest[]     @relation("ExtensionRequester")
  extensionDecisions  ExtensionRequest[]     @relation("ExtensionDecider")
  deadlineOverrides   DeadlineOverride[]
  contentReviews      ContentReview[]
  preClassAnswers     PreClassAnswer[]
  preClassChecks      PreClassCheck[]
  misconceptions      Misconception[]
  challengeAttempts   ChallengeAttempt[]     @relation("ChallengeOwner")
  workshopAttempts    WorkshopAttempt[]
  ctfSolves           CtfSolve[]
  ctfHints            CtfHintUnlock[]
  socScenarios        SocScenario[]
  radarInterventions  RadarIntervention[]
  radarTargets        RadarInterventionTarget[]
  commentSnippets     CommentSnippet[]
  rubricTemplates     RubricTemplate[]
  announcementReads   AnnouncementRead[]
  coursePlans         CoursePlan[]
  clubGoals           ClubGoal[]
  clubPolls           ClubPoll[]
  clubPollVotes       ClubPollVote[]
  clubTasksCreated    ClubTask[]             @relation("ClubTaskCreator")
  clubTasksClaimed    ClubTask[]             @relation("ClubTaskClaimer")
  officeHourSlots     OfficeHourSlot[]
  officeHourBookings  OfficeHourBooking[]
  eventCheckIns       EventCheckIn[]
  eventWaitlist       EventWaitlist[]
  eventFeedback       EventFeedback[]
  personalCards       PersonalCard[]
  savedTerms          SavedTerm[]

  @@index([status, role])
  @@index([createdAt])
}

// Opak oturum token'ı: çerezde ham değer, burada yalnızca SHA-256 hash'i.
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id          String    @id @default(cuid())
  label       String
  // Kod yalnızca oluşturulurken bir kez gösterilir; burada SHA-256 hash'i ve tanıma öneki tutulur.
  codeHash    String    @unique
  codePrefix  String
  role        Role      @default(STUDENT)
  autoApprove Boolean   @default(false)
  maxUses     Int?
  useCount    Int       @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  users       User[]    @relation("InvitationUses")

  @@index([createdAt])
}

// Tekil satır (id = 1). Kurulum tamamlanana kadar setupCompletedAt null'dır.
model ClubSettings {
  id                 Int                @id @default(1)
  clubName           String             @default("Ördek Club")
  description        String             @default("")
  universityName     String             @default("")
  appUrl             String             @default("")
  logoFile           String? // storage/branding altındaki dosya adı
  logoMime           String?
  logoUpdatedAt      DateTime?
  theme              String             @default("dark")
  locale             String             @default("tr")
  timezone           String             @default("Europe/Istanbul")
  registrationPolicy RegistrationPolicy @default(APPROVAL)
  maxUploadMb        Int                @default(25)
  storageQuotaMb     Int                @default(5120) // tüm kulüp dosyaları
  userQuotaMb        Int                @default(200) // öğrenci başına teslim dosyaları
  sessionMaxAgeDays  Int                @default(14)
  sessionIdleHours   Int                @default(72)
  // Güvenli bootstrap: tek seferlik kurulum anahtarının hash'i (kurulumdan sonra silinir).
  setupTokenHash     String?
  setupTokenExpires  DateTime?
  setupCompletedAt   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // ör. "member.approve", "settings.update", "auth.login.failed"
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
}

// ============================================================================
//  Faz 2 — Sunumlar ve canlı sınıf
// ============================================================================

enum PresentationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Presentation {
  id               String                @id @default(cuid())
  title            String
  description      String                @default("")
  status           PresentationStatus    @default(DRAFT)
  ownerId          String?
  owner            User?                 @relation("PresentationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  // En güncel sürüm (canlı oturumlar başlatıldıkları sürüme bağlı kalır).
  currentVersionId String?               @unique
  currentVersion   PresentationVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)
  templateKey      String? // hazır şablondan oluşturulduysa
  // Club Studio otomatik kaydı: yayınlanmamış çalışma kopyası (sürüm oluşturmaz)
  draft            Json?
  draftUpdatedAt   DateTime?
  // Eğitmenlerin "şablon olarak kaydet" ile paylaştığı sunumlar
  isTemplate       Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  versions         PresentationVersion[] @relation("PresentationVersions")
  liveSessions     LiveSession[]

  @@index([status, updatedAt])
  @@index([ownerId])
}

// Değişmez anlık görüntü: içerik değişince yeni sürüm oluşur.
model PresentationVersion {
  id             String        @id @default(cuid())
  presentationId String
  presentation   Presentation  @relation("PresentationVersions", fields: [presentationId], references: [id], onDelete: Cascade)
  number         Int
  // Deste düzeyi alanlar (tema, şema sürümü). Slaytlar Slide satırlarındadır.
  meta           Json
  createdById    String?
  createdBy      User?         @relation("VersionAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  slides         Slide[]
  currentOf      Presentation? @relation("CurrentVersion")
  liveSessions   LiveSession[]

  @@unique([presentationId, number])
}

model Slide {
  id        String              @id @default(cuid())
  versionId String
  version   PresentationVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  // Blok listesi (src/lib/deck-schema.ts ile doğrulanır)
  blocks    Json
  // Eğitmen notları: öğrencilere ASLA gönderilmez
  notes     String              @default("")
  steps     Int                 @default(1)

  @@unique([versionId, position])
}

enum LiveSessionStatus {
  ACTIVE
  ENDED
}

model LiveSession {
  id             String               @id @default(cuid())
  code           String               @unique
  title          String
  presentationId String?
  presentation   Presentation?        @relation(fields: [presentationId], references: [id], onDelete: SetNull)
  versionId      String
  version        PresentationVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  hostId         String?
  host           User?                @relation("LiveHost", fields: [hostId], references: [id], onDelete: SetNull)
  status         LiveSessionStatus    @default(ACTIVE)
  // Sunucuda tutulan senkron durum + sürüm numarası (her değişiklikte +1)
  state          Json
  stateVersion   Int                  @default(0)
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  participants   SessionParticipant[]
  events         LiveSessionEvent[]
  polls          LivePoll[]
  assignments    Assignment[]
  operation ClassroomOperation?
  helpRequests   HelpRequest[]

  @@index([status, startedAt])
}

model SessionParticipant {
  id           String      @id @default(cuid())
  sessionId    String
  session      LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstJoinAt  DateTime    @default(now())
  lastSeenAt   DateTime    @default(now())
  connectedMs  Int         @default(0)
  connectCount Int         @default(0)
  handRaisedAt DateTime?

  @@unique([sessionId, userId])
}

enum LiveEventType {
  QUESTION
  ANNOUNCEMENT
  HAND
}

model LiveSessionEvent {
  id         String        @id @default(cuid())
  sessionId  String
  session    LiveSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?         @relation("LiveEventAuthor", fields: [userId], references: [id], onDelete: SetNull)
  type       LiveEventType
  text       String        @default("")
  resolvedAt DateTime?
  createdAt  DateTime      @default(now())

  @@index([sessionId, type, createdAt])
}

// ============================================================================
//  Faz 3 — Club Academy
//  İçeriğin kaynağı content/academy/ (Markdown). İçe aktarıcı bu tabloları doldurur;
//  ilerleme ve quiz denemeleri öğrenciye aittir ve içerik yeniden aktarılınca korunur.
// ============================================================================

enum TrackKind {
  PROGRAM // akademi hakkında
  CORE // Kısım I — temel modüller (Sezon 1)
  SPECIALIZATION // Kısım II — uzmanlık yolları (Sezon 2)
}

enum LessonKind {
  INFO
  LESSON
  PRACTICE
  QUIZ
}

model Track {
  id         String    @id @default(cuid())
  key        String    @unique // akademi.yaml → anahtar (ör. "m01", "yol-a")
  code       String // görünen kısa kod (ör. "M01", "Yol A")
  kind       TrackKind
  title      String
  summary    String    @default("")
  position   Int
  // Kötü adam ve bölüm bilgisi (karakterler.yaml'dan): { id, ad, unvan, tehdit, ozet, bolum, giris }
  villain    Json?
  archivedAt DateTime? // içerikten kaldırılan yol (ilerleme korunur)
  updatedAt  DateTime  @updatedAt
  lessons    Lesson[]
  exam       TrackExam?
  examAttempts TrackExamAttempt[]
  certificates LearningCertificate[]

  @@index([kind, position])
}

model Lesson {
  id              String           @id @default(cuid())
  slug            String           @unique // sayfa kimliği (ör. "m01-04") — içerik boyunca sabit
  trackId         String
  track           Track            @relation(fields: [trackId], references: [id], onDelete: Cascade)
  position        Int
  kind            LessonKind
  title           String
  minutes         Int              @default(5)
  goals           String[]
  // Markdown gövdesi: iç bağlantılar /academy/..., görseller /api/academy/images/... olarak yeniden yazılmış hâli
  body            String
  // Quiz soruları DOĞRU CEVAPLARLA birlikte burada durur; istemciye asla olduğu gibi gönderilmez.
  quiz            Json?
  // Mini görevler (front-matter `gorevler:`) DOĞRU CEVAP ve geri bildirimleriyle; istemciye publicMissions ile süzülerek gider.
  missions        Json?
  passPercent     Int?
  sourcePath      String // content/academy içindeki göreli yol
  contentHash     String
  archivedAt      DateTime?
  updatedAt       DateTime         @updatedAt
  progress        LessonProgress[]
  attempts        QuizAttempt[]
  missionAttempts MissionAttempt[]
  activities      Json?
  skills          String[] @default([])
  translations    LessonTranslation[]
  personalEntries LessonPersonal[]
  reviewCards ReviewCard[]
  activitySolutions ActivitySolution[]
  questions       LessonQuestion[]
  feedback        LessonFeedback[]
  issueReports    IssueReport[]
  contentReviews  ContentReview[]
  changes         LessonChange[]

  @@index([trackId, position])
  @@index([trackId, archivedAt])
}

enum ProgressStatus {
  STARTED
  COMPLETED
}

model LessonProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(STARTED)
  startedAt   DateTime       @default(now())
  lastViewAt  DateTime       @default(now())
  completedAt DateTime?

  @@unique([userId, lessonId])
  @@index([lessonId, status])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers   Json // öğrencinin seçimleri (soru sırasıyla)
  // Soru başına "emin" (true) / "tahmin" (false); eski denemelerde boş
  confidence Json?
  correct   Int
  total     Int
  score     Int // yüzde
  passed    Boolean
  createdAt DateTime @default(now())

  @@index([userId, lessonId, createdAt])
}

// Mini görev denemeleri: ilerlemenin tek kaynağı. step dolu = adım kontrolü, step boş = görevin tamamlanması.
// firstTry ayrı alan değil; görevdeki ilk yanlış satırdan türetilir. hintsUsed yalnızca öğrenme gözlemi içindir (XP'yi etkilemez).
model MissionAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  missionId String
  step      Int?
  choice    Json
  correct   Boolean
  hintsUsed Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId, lessonId, missionId])
}

// ============================================================================
//  Faz 4 — XP, seviyeler, rozetler, liderlik tabloları
//  XP yalnızca sunucuda, kayıt defteri (ledger) olarak tutulur: her kazanım/geri alma ayrı satırdır,
//  toplam her zaman SUM(amount)'tır. idempotencyKey aynı ödülün iki kez verilmesini veritabanı düzeyinde engeller.
//  Kulüp XP'si Ördek Lab XP sisteminden tamamen ayrıdır.
// ============================================================================

enum XpSource {
  LESSON
  QUIZ
  TRACK
  LIVE
  TASK
  MANUAL
  REVERSAL
}

// Ödül kuralları (miktarlar yönetim panelinden değiştirilebilir).
model XpRewardRule {
  key         String   @id // ör. "lesson.complete", "quiz.pass", "track.complete"
  label       String
  amount      Int
  enabled     Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

model XpTransaction {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation("XpOwner", fields: [userId], references: [id], onDelete: Cascade)
  amount         Int // geri alma ve düzeltmelerde negatif olabilir
  source         XpSource
  ruleKey        String?
  // Aynı ödül ikinci kez yazılamaz (ör. "quiz.pass:<kullanıcı>:<ders>")
  idempotencyKey String         @unique
  reason         String         @default("")
  refType        String?
  refId          String?
  createdById    String?
  createdBy      User?          @relation("XpAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  // Geri alınan işlem; bir işlem en fazla bir kez geri alınabilir
  reversalOfId   String?        @unique
  reversalOf     XpTransaction? @relation("XpReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy     XpTransaction? @relation("XpReversal")
  createdAt      DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Level {
  number Int    @id
  minXp  Int    @unique
  title  String
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String      @default("")
  icon        String      @default("award") // izinli simge listesinden
  // Otomatik kazanım kuralı: { type: "lessons"|"quizzes"|"streak"|"track"|"track_kind"|"xp"|"monthly_rank"|"overall_rank"|"manual", ... }
  rule        Json
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  awards      UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation("BadgeOwner", fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String
  badge       Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  reason      String   @default("")
  awardedById String?
  awardedAt   DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([badgeId])
}

// Öğrenme serileri için: kulübün saat dilimine göre öğrenme yapılan günler.
model ActivityDay {
  userId String
  user   User   @relation("ActivityOwner", fields: [userId], references: [id], onDelete: Cascade)
  day    String // YYYY-MM-DD (kulüp saat dilimi)

  @@id([userId, day])
}

// Ay kapanınca sıralama arşivlenir; geçmiş aylar buradan okunur.
model LeaderboardPeriod {
  period     String             @id // YYYY-MM
  timezone   String
  archivedAt DateTime           @default(now())
  entries    LeaderboardEntry[]
}

model LeaderboardEntry {
  id     String            @id @default(cuid())
  period String
  board  LeaderboardPeriod @relation(fields: [period], references: [period], onDelete: Cascade)
  userId String
  user   User              @relation("LeaderboardUser", fields: [userId], references: [id], onDelete: Cascade)
  rank   Int
  xp     Int

  @@unique([period, userId])
  @@index([period, rank])
}

// ============================================================================
//  Faz 5 — Sınıf yönetimi: dosyalar, görevler, duyurular, bildirimler, canlı quiz/anket
// ============================================================================

// Dosyalar hiçbir zaman statik dizinden sunulmaz: STORAGE_DIR/files altında rastgele adla durur,
// yetki her indirmede sunucuda kontrol edilir.
enum FileScope {
  CLUB // tüm aktif üyeler
  USERS // yalnız izin verilen üyeler (FileGrant)
  ASSIGNMENT // görevin hedefindeki öğrenciler + personel
  SUBMISSION // teslim eden öğrenci + personel
  GROUP // sınıf/etkinlik üyeleri + personel
  MEDIA // sunum görselleri: tüm aktif üyeler (kütüphanede listelenmez)
}

model FileAsset {
  id           String      @id @default(cuid())
  name         String // temizlenmiş görünen ad (yalnızca indirme başlığında kullanılır)
  storageKey   String      @unique // sunucunun ürettiği rastgele dosya adı
  mime         String
  kind         String // pdf | text | image | pcap | zip
  size         Int
  sha256       String
  description  String      @default("")
  scope        FileScope
  ownerId      String?
  owner        User?       @relation("FileOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  groupId      String?
  group        ClassGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  // Tarama özeti (ör. "zip:12 öğe", "clamav:temiz")
  scanNote     String      @default("")
  createdAt    DateTime    @default(now())
  deletedAt    DateTime?
  grants       FileGrant[]

  @@index([scope, deletedAt, createdAt])
  @@index([ownerId])
  @@index([assignmentId])
  @@index([submissionId])
  @@index([groupId])
}

model FileGrant {
  fileId String
  file   FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation("FileGrantUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([fileId, userId])
  @@index([userId])
}

enum AssignmentKind {
  TEXT
  SHORT_ANSWER
  FILE
  PCAP
  LOG
  OSINT
  CODE_REVIEW
  VMWARE
  QUIZ // otomatik puanlanan (çoktan seçmeli, çoklu seçim, D/Y, kısa cevap, eşleştirme)
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AssignmentAudience {
  ALL // tüm aktif öğrenciler
  SELECTED // yalnız AssignmentTarget'taki öğrenciler
  GROUP // bir sınıfın/etkinliğin üyeleri
}

model Assignment {
  id            String             @id @default(cuid())
  title         String
  description   String             @default("") // Markdown
  kind          AssignmentKind     @default(TEXT)
  difficulty    Difficulty         @default(MEDIUM)
  status        AssignmentStatus   @default(DRAFT)
  audience      AssignmentAudience @default(ALL)
  startsAt      DateTime           @default(now())
  dueAt         DateTime?
  allowLate     Boolean            @default(false)
  allowResubmit Boolean            @default(true)
  requireText   Boolean            @default(true)
  requireFile   Boolean            @default(false)
  maxScore      Int                @default(100)
  // Değerlendirme ölçütleri: [{ criterion, points }]
  rubric        Json?
  // XP miktarı sunucudaki kuraldan gelir; xpAmount yalnız personelin sınırlı aralıkta verdiği özel değerdir.
  xpRuleKey     String             @default("task.approved")
  xpAmount      Int?
  createdById   String?
  createdBy     User?              @relation("AssignmentAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  // VMware uygulama molası: canlı oturumdaki slayta bağlı görev
  liveSessionId String?
  liveSession   LiveSession?       @relation(fields: [liveSessionId], references: [id], onDelete: SetNull)
  slideId       String?
  groupId       String?
  group         ClassGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Grup görevi: takım başına tek teslim; onayda XP takımdaki herkese
  teamMode      Boolean            @default(false)
  // Otomatik puanlanan görev: sorular (cevap anahtarı yalnız sunucuda), geçme yüzdesi, deneme sınırı
  quiz          Json?
  passPercent   Int                @default(60)
  maxAttempts   Int?
  // Teslim öncesi kontrol listesi maddeleri ve beceri etiketleri (beceri kanıtı)
  checklist     String[]           @default([])
  skills        String[]           @default([])
  // Kontrollü akran değerlendirmesi: öğretmen açar, son not öğretmende kalır
  peerReviewEnabled Boolean        @default(false)
  peerReviewCount   Int            @default(2)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  peerReviews   PeerReview[]
  extensionRequests ExtensionRequest[]
  deadlineOverrides DeadlineOverride[]
  teams         AssignmentTeam[]
  targets       AssignmentTarget[]
  submissions   Submission[]
  files         FileAsset[]

  @@unique([liveSessionId, slideId])
  @@index([status, startsAt])
  @@index([createdById])
}

model AssignmentTarget {
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("AssignmentTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
  @@index([userId])
}

enum SubmissionStatus {
  SUBMITTED // değerlendirme bekliyor
  RETURNED // düzeltme istendi (yeniden teslim edilebilir)
  APPROVED // onaylandı (XP verildi; kesindir)
  REJECTED // reddedildi
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("SubmissionAuthor", fields: [userId], references: [id], onDelete: Cascade)
  text         String           @default("")
  status       SubmissionStatus @default(SUBMITTED)
  attempts     Int              @default(1)
  late         Boolean          @default(false)
  submittedAt  DateTime         @default(now())
  score        Int?
  rubricScores Json?
  feedback     String           @default("")
  reviewedById String?
  reviewedBy   User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  teamId       String?          @unique
  team         AssignmentTeam?  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  answers      Json?
  // İşaretlenen kontrol listesi maddeleri (gönderim anındaki liste kopyasıyla)
  checklist    Json?
  files        FileAsset[]
  versions     SubmissionVersion[]
  peerReviews  PeerReview[]

  @@unique([assignmentId, userId])
  @@index([assignmentId, status])
}

enum AnnouncementAudience {
  ALL
  STAFF
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  body        String               @default("") // Markdown
  audience    AnnouncementAudience @default(ALL)
  pinned      Boolean              @default(false)
  createdById String?
  createdBy   User?                @relation("AnnouncementAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())
  // Planlı duyuru: bu zamandan önce üyelere görünmez
  publishAt   DateTime             @default(now())
  // Planlı duyurunun bildirimi yayın zamanında bir kez gönderilir
  notifiedAt  DateTime?
  expiresAt   DateTime?
  reads       AnnouncementRead[]

  @@index([createdAt])
  @@index([publishAt])
}

enum NotificationType {
  ANNOUNCEMENT
  ASSIGNMENT
  REVIEW
  SUBMISSION
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String           @default("")
  link      String? // yalnız uygulama içi yol (/ ile başlar)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

enum PollKind {
  QUIZ // doğru cevabı olan, isimli
  POLL // anket (isteğe bağlı anonim)
}

enum PollStatus {
  OPEN
  CLOSED
  REVEALED
}

model LivePoll {
  id           String           @id @default(cuid())
  sessionId    String
  session      LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  purpose      String @default("LIVE")
  kind         PollKind
  question     String
  options      Json // string[]
  correctIndex Int? // yalnız QUIZ; sonuç açıklanana kadar öğrenciye gönderilmez
  anonymous    Boolean          @default(false)
  timeLimitSec Int
  status       PollStatus       @default(OPEN)
  openedAt     DateTime         @default(now())
  closesAt     DateTime
  answers      LivePollAnswer[]

  @@index([sessionId, openedAt])
}

model LivePollAnswer {
  pollId    String
  poll      LivePoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("PollAnswerUser", fields: [userId], references: [id], onDelete: Cascade)
  choice    Int
  createdAt DateTime @default(now())

  @@id([pollId, userId])
}

// ───────────────────────────── Faz 6 ─────────────────────────────

enum GroupKind {
  CLASS // sınıf/şube: üyeleri personel belirler
  EVENT // etkinlik: tarih/yer; isteğe bağlı öğrenci kaydı
}

model ClassGroup {
  id          String             @id @default(cuid())
  kind        GroupKind          @default(CLASS)
  name        String
  description String             @default("")
  startsAt    DateTime?
  endsAt      DateTime?
  location    String             @default("")
  selfJoin    Boolean            @default(false) // öğrenci kendisi kaydolabilir (etkinlik)
  capacity    Int?
  archivedAt  DateTime?
  createdById String?
  createdBy   User?              @relation("GroupAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     ClassGroupMember[]
  assignments Assignment[]
  files       FileAsset[]
  examProtections ExamProtection[]
  // Etkinlik katılım kodu: ham kod yalnız öğretmen ekranında, burada SHA-256 hash'i
  checkInCodeHash  String?
  checkInExpiresAt DateTime?
  checkIns        EventCheckIn[]
  waitlist        EventWaitlist[]
  eventFeedback   EventFeedback[]
  preClassChecks  PreClassCheck[]
  interventions   RadarIntervention[]
  coursePlans     CoursePlan[]

  @@index([kind, archivedAt])
}

model ClassGroupMember {
  groupId  String
  group    ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation("GroupMember", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime   @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model AssignmentTeam {
  id           String                 @id @default(cuid())
  assignmentId String
  assignment   Assignment             @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  name         String
  members      AssignmentTeamMember[]
  submission   Submission?

  @@unique([assignmentId, name])
}

model AssignmentTeamMember {
  teamId       String
  team         AssignmentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation("TeamMember", fields: [userId], references: [id], onDelete: Cascade)
  assignmentId String // bir öğrenci bir görevde tek takımda olabilir

  @@id([teamId, userId])
  @@unique([assignmentId, userId])
}

// Parola sıfırlama: e-postadaki token'ın yalnız SHA-256 hash'i; tek kullanımlık, kısa ömürlü.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  ip        String    @default("")
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

// Giden e-posta kuyruğu: istek yolunu SMTP'ye bağlamaz; arka plan işçisi gönderir ve yeniden dener.
model EmailOutbox {
  id            String      @id @default(cuid())
  to            String
  subject       String
  text          String
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  lastError     String      @default("")
  nextAttemptAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
}

// Academy expansion: additive models; existing identities and progress stay unchanged.
model LearningPreference {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyGoal Int @default(1)
  reminderEnabled Boolean @default(false)
  reminderTime String @default("19:00")
  reminderEmail Boolean @default(false)
  // Site ve ders dili: "auto" (tarayıcı/sistem dili), "tr" veya "en"
  locale String @default("auto")
  protectionStart String
  // Okuma ve erişilebilirlik tercihleri
  fontScale Int @default(100)
  lineHeight String @default("normal")
  readableFont Boolean @default(false)
  highContrast Boolean @default(false)
  reduceMotion Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearningEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  key String
  day String
  kind String
  createdAt DateTime @default(now())
  @@unique([userId, key])
  @@index([userId, day])
}

model ExamProtection {
  id String @id @default(cuid())
  groupId String
  group ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  startsOn String
  endsOn String
  memberIds String[] @default([])
  createdAt DateTime @default(now())
  @@index([groupId, startsOn])
}

model LearningPlan {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  title String
  day String
  completed Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([userId, day])
}

model LessonPersonal {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson Lesson @relation(fields:[lessonId],references:[id],onDelete:Cascade)
  note String @default("")
  bookmarked Boolean @default(false)
  // Kaldığın yerden devam: son okunan bölüm çapası
  lastSection String @default("")
  updatedAt DateTime @updatedAt
  @@id([userId, lessonId])
}

model ReviewCard {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson Lesson @relation(fields:[lessonId],references:[id],onDelete:Cascade)
  questionIndex Int
  contentHash String
  question Json
  consecutive Int @default(0)
  dueAt DateTime
  closed Boolean @default(false)
  version Int @default(0)
  updatedAt DateTime @updatedAt
  @@unique([userId, lessonId, questionIndex])
  @@index([userId, dueAt])
}

model LearningReminder {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  day String
  createdAt DateTime @default(now())
  @@id([userId, day])
}

model FeatureSwitch {
  key String @id
  enabled Boolean @default(false)
  enabledAt DateTime?
  updatedAt DateTime @updatedAt
}


model LessonTranslation {
  lessonId String
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  locale String
  title String
  body String
  goals String[]
  activities Json?
  contentHash String
  updatedAt DateTime @updatedAt
  @@id([lessonId, locale])
}
model ActivitySolution {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  activityId String
  contentHash String
  solvedAt DateTime @default(now())
  @@id([userId, lessonId, activityId, contentHash])
}

model PlacementAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Json
  score Int
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model PortfolioWork {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissionId String
  visible Boolean @default(false)
  // Gelişim hikâyesi
  problem String @default("")
  approach String @default("")
  result String @default("")
  learned String @default("")
  updatedAt DateTime @updatedAt
  @@id([userId, submissionId])
}

model BankQuestion {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  skill String
  difficulty String
  createdAt DateTime @default(now())
  revisions QuestionRevision[]
}
model QuestionRevision {
  id String @id @default(cuid())
  questionId String
  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  number Int
  content Json
  createdAt DateTime @default(now())
  @@unique([questionId, number])
}

model ClassroomOperation {
  id String @id @default(cuid())
  sessionId String @unique
  session LiveSession @relation(fields:[sessionId],references:[id],onDelete:Cascade)
  scenarioVersion Int @default(1)
  status String @default("ACTIVE")
  stage Int @default(0)
  version Int @default(0)
  history Json @default("[]")
  createdAt DateTime @default(now())
  participants OperationParticipant[]
  votes OperationVote[]
}
model OperationParticipant {
  operationId String
  operation ClassroomOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  team Int
  // Aşama başına üstlenilen rol: [{ stage, role }] (0 analiz, 1 iletişim, 2 müdahale)
  roleHistory Json @default("[]")
  @@id([operationId, userId])
}
model OperationVote {
  operationId String
  operation ClassroomOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  stage Int
  choice Int
  createdAt DateTime @default(now())
  @@id([operationId, userId, stage])
}

model CtfTeam {
  id String @id @default(cuid())
  name String @unique
  joinCodeHash String @unique
  captainId String
  captain User @relation(fields:[captainId],references:[id],onDelete:Restrict)
  createdAt DateTime @default(now())
  members CtfTeamMember[]
}
// CTF panosu: çözümler (kullanıcı başına görev başına bir kez) ve satın alınan ipuçları (puandan düşülür).
model CtfSolve {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeKey String
  teamId       String?
  createdAt    DateTime @default(now())

  @@unique([userId, challengeKey])
  @@index([challengeKey, createdAt])
  @@index([teamId])
}
model CtfHintUnlock {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeKey String
  hint         Int
  createdAt    DateTime @default(now())

  @@id([userId, challengeKey, hint])
}
model CtfTeamMember {
  teamId String
  team CtfTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())
  @@id([teamId, userId])
}
model ReportDraft {
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  labKey String
  title String
  evidence String
  impact String
  recommendation String
  // Rubrikli geri bildirim: DRAFT → SUBMITTED → REVIEWED
  status String @default("DRAFT")
  submittedAt DateTime?
  rubricScores Json?
  feedback String @default("")
  reviewerId String?
  reviewedAt DateTime?
  updatedAt DateTime @updatedAt
  @@id([userId, labKey])
}
model SocAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  alertKey String
  decision String
  correct Boolean
  createdAt DateTime @default(now())
  @@unique([userId, alertKey])
}

model TrackExam {
  trackId String @id
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
  questions Json
  version Int @default(1)
  updatedAt DateTime @updatedAt
}
model TrackExamAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId String
  track Track @relation(fields:[trackId],references:[id],onDelete:Cascade)
  examVersion Int
  questions Json
  createdAt DateTime @default(now())
  submittedAt DateTime?
  score Int?
  passed Boolean @default(false)
  @@index([userId, trackId, createdAt])
}
model LearningCertificate {
  id String @id @default(cuid())
  token String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId String
  track Track @relation(fields:[trackId],references:[id],onDelete:Cascade)
  ownerName String
  trackTitle String
  shareName Boolean @default(false)
  awardedAt DateTime @default(now())
  @@unique([userId, trackId])
}

// ============================================================================
//  Platform genişlemesi (101 özellik): çalışma, topluluk, değerlendirme, öğretmen içgörüsü,
//  atölyeler ve kulüp işleri. Yalnız ekleme; durum alanları CHECK kısıtlarıyla sınırlanır.
// ============================================================================

// Çalışma oturumu: süre tek başına XP üretmez; bitişte kısa değerlendirme istenir.
model StudySession {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  minutes    Int
  topic      String
  lessonSlug String?
  skill      String?
  status     String    @default("ACTIVE") // ACTIVE | DONE | ABANDONED
  startedAt  DateTime  @default(now())
  endsAt     DateTime
  endedAt    DateTime?
  reflection String    @default("")
  // Öz-kontrol: { understood: 1-5, nextStep: string }
  selfCheck  Json?

  @@index([userId, startedAt])
}

model StudyGoal {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  targetDay String // YYYY-MM-DD
  trackKeys String[] @default([])
  updatedAt DateTime @updatedAt
}

model BuddyPost {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String
  body      String
  skill     String?
  status    String       @default("OPEN") // OPEN | CLOSED | HIDDEN
  flags     Int          @default(0)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  replies   BuddyReply[]

  @@index([status, createdAt])
}

model BuddyReply {
  id        String    @id @default(cuid())
  postId    String
  post      BuddyPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([postId, createdAt])
}

model StudyCircle {
  id        String              @id @default(cuid())
  name      String
  topic     String              @default("")
  plan      String              @default("")
  ownerId   String
  owner     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())
  members   StudyCircleMember[]
}

model StudyCircleMember {
  circleId String
  circle   StudyCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime    @default(now())

  @@id([circleId, userId])
  @@index([userId])
}

// Teşekkür notu: XP üretmez; aynı bağlam için bir kez.
model Thanks {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("ThanksFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("ThanksTo", fields: [toId], references: [id], onDelete: Cascade)
  message   String   @default("")
  context   String // ör. "answer:<id>", "buddy:<id>"
  createdAt DateTime @default(now())

  @@unique([fromId, toId, context])
  @@index([toId])
}

model LessonQuestion {
  id        String         @id @default(cuid())
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId String         @default("")
  body      String
  status    String         @default("OPEN") // OPEN | ANSWERED | HIDDEN
  createdAt DateTime       @default(now())
  answers   LessonAnswer[]

  @@index([lessonId, status, createdAt])
}

model LessonAnswer {
  id         String         @id @default(cuid())
  questionId String
  question   LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  body       String
  staff      Boolean        @default(false)
  accepted   Boolean        @default(false)
  createdAt  DateTime       @default(now())

  @@index([questionId, createdAt])
}

// Ders değerlendirmesi (1-5) ve "en belirsiz nokta"
model LessonFeedback {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  rating    Int?
  comment   String   @default("")
  unclear   String   @default("")
  updatedAt DateTime @updatedAt

  @@id([userId, lessonId])
  @@index([lessonId])
}

// Sorun bildirimi: görünen takip numarası HB-<number>
model IssueReport {
  id        String   @id @default(cuid())
  number    Int      @unique @default(autoincrement())
  userId    String?
  user      User?    @relation("IssueReporter", fields: [userId], references: [id], onDelete: SetNull)
  lessonId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  location  String   @default("") // uygulama içi yol veya bölüm
  kind      String   @default("CONTENT") // CONTENT | TECHNICAL | TRANSLATION
  body      String
  status    String   @default("RECEIVED") // RECEIVED | REVIEWING | FIXED | REJECTED
  // [{ status, note, at }]
  history   Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([userId])
}

// İçerik değişikliği: içe aktarıcı contentHash değiştiğinde yazar.
model LessonChange {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  oldHash   String
  newHash   String
  oldTitle  String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model HelpRequest {
  id           String      @id @default(cuid())
  sessionId    String
  session      LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  note         String      @default("")
  taskRef      String      @default("")
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  @@index([sessionId, resolvedAt])
}

model PeerReview {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User       @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  rubricScores Json?
  comment      String     @default("")
  status       String     @default("ASSIGNED") // ASSIGNED | DONE
  createdAt    DateTime   @default(now())
  submittedAt  DateTime?

  @@unique([submissionId, reviewerId])
  @@index([reviewerId, status])
}

model SubmissionVersion {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  number       Int
  text         String
  answers      Json?
  fileIds      String[]   @default([])
  createdAt    DateTime   @default(now())

  @@unique([submissionId, number])
}

model ExtensionRequest {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("ExtensionRequester", fields: [userId], references: [id], onDelete: Cascade)
  reason       String
  requestedDue DateTime
  status       String     @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById  String?
  decidedBy    User?      @relation("ExtensionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String     @default("")
  createdAt    DateTime   @default(now())

  @@index([assignmentId, status])
  @@index([userId])
}

model DeadlineOverride {
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dueAt        DateTime
  createdAt    DateTime   @default(now())

  @@id([assignmentId, userId])
}

// İçerik onayı: aynı içerik sürümü (contentHash) için aşama başına son karar geçerlidir.
model ContentReview {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  contentHash String
  stage       String // AUTHOR | TECH | LANGUAGE
  decision    String // APPROVED | CHANGES
  note        String   @default("")
  reviewerId  String?
  reviewer    User?    @relation(fields: [reviewerId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([lessonId, contentHash])
}

// Ders öncesi yoklama: notlandırılmaz.
model PreClassCheck {
  id          String           @id @default(cuid())
  groupId     String?
  group       ClassGroup?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  // [{ question, options: string[] }]
  questions   Json
  opensAt     DateTime         @default(now())
  closesAt    DateTime
  createdById String?
  createdBy   User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  answers     PreClassAnswer[]

  @@index([groupId, closesAt])
}

model PreClassAnswer {
  checkId   String
  check     PreClassCheck @relation(fields: [checkId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Json
  createdAt DateTime      @default(now())

  @@id([checkId, userId])
}

model Misconception {
  id          String   @id @default(cuid())
  title       String
  belief      String
  explanation String
  skills      String[] @default([])
  lessonSlugs String[] @default([])
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Yetkinlik gösterme: otomatik puan + öğretmen kararı; muafiyet ayrı alan.
model ChallengeAttempt {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation("ChallengeOwner", fields: [userId], references: [id], onDelete: Cascade)
  challengeKey String
  answers      Json
  evidence     String    @default("")
  score        Int
  status       String    @default("SUBMITTED") // SUBMITTED | ACCEPTED | REJECTED
  exemption    Boolean   @default(false)
  decidedById  String?
  decidedAt    DateTime?
  note         String    @default("")
  createdAt    DateTime  @default(now())

  @@index([userId, challengeKey])
  @@index([status])
}

// Atölye denemesi: kind = secure-code | network | query | timeline | evidence-map
model WorkshopAttempt {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         String
  key          String
  payload      Json
  score        Int
  passed       Boolean
  review       String    @default("")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, kind, key])
  @@index([kind, key, createdAt])
}

// Nöbet Masası senaryosu: düzenleme sürümü artırır; denemeler sürüme bağlıdır.
model SocScenario {
  id        String   @id @default(cuid())
  title     String
  summary   String   @default("")
  // { easy: Alert[], medium: Alert[], hard: Alert[] }
  variants  Json
  version   Int      @default(1)
  status    String   @default("DRAFT") // DRAFT | PUBLISHED | ARCHIVED
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model RadarIntervention {
  id          String                    @id @default(cuid())
  groupId     String
  group       ClassGroup                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  skill       String
  lessonSlugs String[]                  @default([])
  note        String                    @default("")
  dueAt       DateTime?
  // Atama anındaki hedef öğrencilerin beceri yüzdesi (önce/sonra karşılaştırması)
  baseline    Int?
  createdById String?
  createdBy   User?                     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime                  @default(now())
  targets     RadarInterventionTarget[]

  @@index([groupId, createdAt])
}

model RadarInterventionTarget {
  interventionId String
  intervention   RadarIntervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt    DateTime?

  @@id([interventionId, userId])
  @@index([userId])
}

model CommentSnippet {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  label     String
  text      String
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model RubricTemplate {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  rubric    Json // [{ criterion, points }]
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model AnnouncementRead {
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([announcementId, userId])
}

model CoursePlan {
  id          String     @id @default(cuid())
  groupId     String
  group       ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  week        Int
  startsOn    String // YYYY-MM-DD
  title       String
  lessonSlugs String[]   @default([])
  note        String     @default("")
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([groupId, week])
}

// Kulüp ortak hedefi: kooperatif, bireysel sıralama yok.
model ClubGoal {
  id          String   @id @default(cuid())
  title       String
  metric      String // LESSONS | LABS | STUDY_MINUTES
  target      Int
  startsOn    String
  endsOn      String
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([endsOn])
}

model ClubPoll {
  id          String         @id @default(cuid())
  question    String
  options     Json // string[]
  anonymous   Boolean        @default(true)
  closesAt    DateTime?
  createdById String?
  createdBy   User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  votes       ClubPollVote[]
}

model ClubPollVote {
  pollId    String
  poll      ClubPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  choice    Int
  createdAt DateTime @default(now())

  @@id([pollId, userId])
}

model ClubTask {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  dueAt       DateTime?
  status      String    @default("OPEN") // OPEN | CLAIMED | DONE
  claimedById String?
  claimedBy   User?     @relation("ClubTaskClaimer", fields: [claimedById], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("ClubTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  @@index([status, createdAt])
}

model OfficeHourSlot {
  id        String              @id @default(cuid())
  hostId    String
  host      User                @relation(fields: [hostId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int                 @default(1)
  location  String              @default("")
  createdAt DateTime            @default(now())
  bookings  OfficeHourBooking[]

  @@index([startsAt])
}

model OfficeHourBooking {
  id        String         @id @default(cuid())
  slotId    String
  slot      OfficeHourSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String
  status    String         @default("BOOKED") // BOOKED | CANCELLED | DONE
  createdAt DateTime       @default(now())

  @@unique([slotId, userId])
}

model EventCheckIn {
  groupId String
  group   ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  method  String     @default("CODE") // CODE | MANUAL
  at      DateTime   @default(now())

  @@id([groupId, userId])
  @@index([userId])
}

model EventWaitlist {
  groupId    String
  group      ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  notifiedAt DateTime?

  @@id([groupId, userId])
}

model EventFeedback {
  groupId   String
  group     ClassGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String     @default("")
  createdAt DateTime   @default(now())

  @@id([groupId, userId])
}

// Öğrencinin kendi oluşturduğu tekrar kartı (not veya terimden)
model PersonalCard {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  front       String
  back        String
  source      String   @default("NOTE") // NOTE | TERM
  ref         String   @default("")
  consecutive Int      @default(0)
  dueAt       DateTime @default(now())
  closed      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, dueAt])
}

model SavedTerm {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termId    String
  createdAt DateTime @default(now())

  @@id([userId, termId])
}
